# ── Claude API ────────────────────────────────────────────────────────────────
# Your Anthropic API key. Server-side only — never expose with NEXT_PUBLIC_.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Model used for CV analysis, application kits and the AI job scout.
CLAUDE_MODEL=claude-opus-5-5

# ── Site login ────────────────────────────────────────────────────────────────
# Credentials for the login gate. REQUIRED — the app refuses logins if unset.
AUTH_USERNAME=changeme
AUTH_PASSWORD=changeme

# Random string used to sign session cookies (any long random value).
# Generate one: openssl rand -hex 32
AUTH_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# If set, the public MCP endpoint (/api/mcp) requires this bearer token.
MCP_TOKEN=
